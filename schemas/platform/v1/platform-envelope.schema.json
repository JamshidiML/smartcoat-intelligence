{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smartcoat:schema:platform:v1:envelope",
  "title": "SmartCoat Industry-Agnostic Platform Envelope v1.1",
  "type": "object",
  "required": [
    "object_id",
    "object_type",
    "canonical_name",
    "schema_version",
    "organization_id",
    "owner",
    "confidentiality",
    "governance_schema_version",
    "purpose_decisions",
    "lifecycle_state",
    "review",
    "provenance",
    "evidence_references",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "object_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*:[A-Za-z0-9._-]+$"
    },
    "object_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "canonical_name": {"type": "string", "minLength": 1},
    "description": {"type": ["string", "null"]},
    "schema_version": {"const": "1.1.0"},
    "governance_schema_version": {"const": "smartcoat-governance-v1.1-draft"},
    "organization_id": {"type": "string", "minLength": 1},
    "site_id": {"type": ["string", "null"]},
    "owner": {
      "type": "object",
      "required": ["owner_id", "role"],
      "properties": {
        "owner_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "confidentiality": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "restricted", "strategic"]
    },
    "purpose_decisions": {
      "type": "object",
      "required": ["inventory", "retrieval", "analytics", "human_review", "model_training", "external_sharing"],
      "properties": {
        "inventory": {"$ref": "#/$defs/purposeDecision"},
        "retrieval": {"$ref": "#/$defs/purposeDecision"},
        "analytics": {"$ref": "#/$defs/purposeDecision"},
        "human_review": {"$ref": "#/$defs/purposeDecision"},
        "model_training": {"$ref": "#/$defs/purposeDecision"},
        "external_sharing": {"$ref": "#/$defs/purposeDecision"}
      },
      "additionalProperties": false
    },
    "lifecycle_state": {
      "type": "string",
      "enum": ["draft", "captured", "reviewed", "validated", "approved", "deprecated", "rejected"]
    },
    "review": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["not_reviewed", "in_review", "accepted", "validated", "rejected", "needs_correction"]},
        "reviewer_id": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["accepted", "validated"]}}},
          "then": {
            "required": ["reviewer_id", "reviewed_at"],
            "properties": {
              "reviewer_id": {"type": "string", "minLength": 1},
              "reviewed_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "provenance": {
      "type": "object",
      "required": [
        "source_system",
        "source_reference",
        "created_by",
        "creation_method",
        "captured_at",
        "transformation_history"
      ],
      "properties": {
        "source_system": {"type": "string", "minLength": 1},
        "source_reference": {"type": "string", "minLength": 1},
        "created_by": {"type": "string", "minLength": 1},
        "creation_method": {"type": "string", "minLength": 1},
        "source_created_at": {"type": ["string", "null"], "format": "date-time"},
        "captured_at": {"type": "string", "format": "date-time"},
        "transformation_history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["at", "actor", "method"],
            "properties": {
              "at": {"type": "string", "format": "date-time"},
              "actor": {"type": "string", "minLength": 1},
              "method": {"type": "string", "minLength": 1},
              "input_reference": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "evidence_references": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relationship_type", "target_id"],
        "properties": {
          "relationship_type": {"type": "string", "minLength": 1},
          "target_id": {"type": "string", "minLength": 1},
          "valid_from": {"type": ["string", "null"], "format": "date-time"},
          "valid_to": {"type": ["string", "null"], "format": "date-time"},
          "evidence_reference": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "purposeDecision": {
      "enum": ["not_requested", "in_review", "approved", "denied", "expired", "revoked"]
    },
    "measurement": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": {
          "enum": ["known", "unknown", "not_measured", "not_applicable", "conflicting"]
        },
        "value": {"type": ["number", "string", "boolean", "null"]},
        "unit": {"type": ["string", "null"]},
        "normalized_value": {"type": ["number", "null"]},
        "normalized_unit": {"type": ["string", "null"]},
        "conflicting_values": {
          "type": "array",
          "items": {"type": ["number", "string", "boolean"]}
        },
        "method_reference": {"type": ["string", "null"]},
        "uncertainty": {"type": ["number", "null"], "minimum": 0},
        "notes": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "known"}}},
          "then": {
            "required": ["value"],
            "properties": {"value": {"type": ["number", "string", "boolean"]}},
            "not": {"required": ["conflicting_values"]}
          }
        },
        {
          "if": {"properties": {"state": {"enum": ["unknown", "not_measured", "not_applicable"]}}},
          "then": {
            "not": {
              "anyOf": [
                {"required": ["value"]},
                {"required": ["normalized_value"]},
                {"required": ["conflicting_values"]}
              ]
            }
          }
        },
        {
          "if": {"properties": {"state": {"const": "conflicting"}}},
          "then": {
            "required": ["conflicting_values"],
            "properties": {"conflicting_values": {"minItems": 2}},
            "not": {
              "anyOf": [
                {"required": ["value"]},
                {"required": ["normalized_value"]}
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "object_id": "knowledge_object:synthetic-platform-object-a",
      "object_type": "knowledge_object",
      "canonical_name": "Synthetic Platform Object A",
      "description": "Industry-agnostic generalized platform-envelope fixture.",
      "schema_version": "1.1.0",
      "governance_schema_version": "smartcoat-governance-v1.1-draft",
      "organization_id": "org_synthetic",
      "site_id": "site_synthetic",
      "owner": {"owner_id": "role:material-steward", "role": "material_steward"},
      "confidentiality": "internal",
      "purpose_decisions": {
        "inventory": "approved",
        "retrieval": "not_requested",
        "analytics": "not_requested",
        "human_review": "approved",
        "model_training": "denied",
        "external_sharing": "denied"
      },
      "lifecycle_state": "draft",
      "review": {"status": "not_reviewed"},
      "confidence": 0.8,
      "provenance": {
        "source_system": "synthetic_register",
        "source_reference": "synthetic://materials/a",
        "created_by": "synthetic_fixture",
        "creation_method": "manual_synthetic_fixture",
        "source_created_at": "2026-01-01T00:00:00Z",
        "captured_at": "2026-01-02T00:00:00Z",
        "transformation_history": []
      },
      "evidence_references": ["evidence:synthetic-tds-a"],
      "relationships": [],
      "created_at": "2026-01-02T00:00:00Z",
      "updated_at": "2026-01-02T00:00:00Z"
    }
  ]
}
