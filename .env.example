# SmartCoat local development configuration

SMARTCOAT_ENV=development
SMARTCOAT_APP_NAME=SmartCoat Intelligence
SMARTCOAT_API_HOST=0.0.0.0
SMARTCOAT_API_PORT=8000

# PostgreSQL
SMARTCOAT_DATABASE_URL=postgresql+psycopg://smartcoat:smartcoat@localhost:5432/smartcoat

# Security placeholders
SMARTCOAT_SECRET_KEY=change-me
SMARTCOAT_ENABLE_DEBUG=true

# Local voice/project-intake pilot (no hosted AI provider)
SMARTCOAT_VOICE_TRANSCRIPTION_BACKEND=mlx_whisper
SMARTCOAT_WHISPER_MODEL=mlx-community/whisper-small-mlx
SMARTCOAT_OLLAMA_BASE_URL=http://127.0.0.1:11434
SMARTCOAT_OLLAMA_MODEL=qwen2.5:7b
SMARTCOAT_ASSET_ROOT=~/.local/share/smartcoat/pilot-assets
SMARTCOAT_MAX_UPLOAD_BYTES=26214400
